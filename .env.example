# Copy to .env and fill in as needed. All values are optional; sane defaults apply.

# Minutes to cache a source's results before re-fetching it (per source).
REFRESH_TTL_MINUTES=60

# Raises GitHub API rate limits from 60/hr to 5000/hr. Needs no scopes (public data only).
GITHUB_TOKEN=

# If AI_GISTS_ENABLED=true, gists are generated with Gemini first (GEMINI_API_KEY,
# model below), falling back to Claude (ANTHROPIC_API_KEY, claude-haiku-4-5) if
# Gemini is unset or errors. If neither key works, gists fall back to a cleaned-up
# version of the feed's own summary. GEMINI_API_KEY must be a Google AI Studio API
# key (aistudio.google.com) — the consumer Gemini Pro/Advanced app subscription
# does not by itself grant programmatic API access.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
AI_GISTS_ENABLED=false

# How many days back counts as "trending" for GitHub repo search.
TRENDING_WINDOW_DAYS=7

# Cap on how many items are kept per individual source, to keep the DB tidy.
MAX_ITEMS_PER_SOURCE=20
